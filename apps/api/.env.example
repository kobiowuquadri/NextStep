# NextStep API configuration. Copy to .env for local development. Placeholders only — never commit real values.
NODE_ENV=development
PORT=4000

# PostgreSQL (UTF-8). Local: `docker compose up -d db` or `pnpm --filter @nextstep/api db:embedded`.
DATABASE_URL=postgresql://nextstep:nextstep@localhost:54329/nextstep

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-value-from-openssl
JWT_ISSUER=nextstep-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed to call the API (website). Mobile apps don't send an Origin header.
CORS_ORIGINS=http://localhost:3000
# Where password reset links point (the website's /reset-password page).
APP_PUBLIC_URL=http://localhost:3000
# Set to true behind a reverse proxy / load balancer so rate limits use the client IP.
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20
# error | warn | log | debug | verbose
LOG_LEVEL=log

# Optional email delivery for password resets. Without SMTP, no email is sent (development logs the link).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=NextStep <no-reply@your-domain.example>

# Optional AI suggestions. Leave empty to disable; planning and Recovery Mode never need it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=20000
AI_DAILY_LIMIT_PER_USER=20

# Seeding the fictional demo account is opt-in and should not be used on a public production database.
SEED_DEMO_ACCOUNT=false
SEED_DEMO_EMAIL=tobi@demo.nextstep.invalid
SEED_DEMO_PASSWORD=
