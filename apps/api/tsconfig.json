{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "declaration": false,
    "declarationMap": false,
    "noUncheckedIndexedAccess": false,
    "types": [
