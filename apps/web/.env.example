# Public site configuration. Only NEXT_PUBLIC_* values reach the browser — never put secrets here.
NEXT_PUBLIC_SITE_URL=https://nextstep.example.com
# Leave empty until real store/release links exist; the site then shows an honest availability message.
NEXT_PUBLIC_ANDROID_URL=
NEXT_PUBLIC_IOS_URL=
NEXT_PUBLIC_APK_URL=
# Optional public contact address for the team. Omitted from the site when empty.
NEXT_PUBLIC_CONTACT_EMAIL=
