  "dependencies": {
    "@nextstep/contracts": "workspace:*",
    "@nextstep/design-tokens": "workspace:*",
    "@nextstep/engine": "workspace:*",
    "@nextstep/gamification": "workspace:*",
    "@nextstep/scheduler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
