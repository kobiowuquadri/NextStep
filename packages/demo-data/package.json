{
  "name": "@nextstep/demo-data",
  "version": "1.0.0",
  "private": true,
  "description": "Fictional demo scenarios (Tobi) and original sample learning resources. Never imported by production data paths.",
  "type": "module",
  "main": "./dist/index.js",
