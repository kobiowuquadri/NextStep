{
  "name": "@nextstep/engine",
  "version": "1.0.0",
  "private": true,
  "description": "Pure domain actions shared by the mobile app and the browser demo. Storage-agnostic: every action returns the new state plus the list of record mutations to persist and sync.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nextstep/contracts": "workspace:*",
    "@nextstep/gamification": "workspace:*",
    "@nextstep/scheduler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
